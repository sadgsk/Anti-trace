{
	"name": "cli-agent",
	"private": true,
	"version": "0.1.0",
	"description": "Minimal evolvable CLI agent skeleton, shaped like pi-agent-core",
	"type": "module",
	"scripts": {
		"start": "tsx src/cli/main.ts",
		"probe": "tsx test/probe-llm.ts",
		"probe:bash": "tsx test/probe-bash.ts",
		"probe:read": "tsx test/probe-read.ts",
		"probe:write": "tsx test/probe-write.ts",
		"probe:edit": "tsx test/probe-edit.ts",
		"probe:loop": "tsx test/probe-loop.ts",
		"probe:agent": "tsx test/probe-agent.ts",
		"probe:harness": "tsx test/probe-harness.ts",
		"probe:session": "tsx test/probe-session.ts",
		"probe:image-order": "tsx test/probe-tool-image-order.ts",
		"test:images": "tsx test/tool-result-images.test.ts",
		"test:input": "tsx --test test/text-input-state.test.ts test/text-input-controller.test.ts test/base-text-input.test.tsx test/paste-handler.test.ts test/image-paste.test.ts",
		"typecheck": "tsc --noEmit",
		"build": "tsc"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"ink": "6.5.1",
		"react": "19.2.4",
		"react-devtools-core": "6.1.2",
		"string-width": "8.3.0",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/react": "19.2.18",
		"tsx": "4.21.0",
		"typescript": "5.9.3"
	}
}
