{
	"name": "residualx",
	"version": "0.2.1",
	"license": "MIT",
	"description": "Terminal AI coding agent with bring-your-own-key model support",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sadgsk/ResidualX.git"
	},
	"homepage": "https://github.com/sadgsk/ResidualX#readme",
	"bugs": {
		"url": "https://github.com/sadgsk/ResidualX/issues"
	},
	"files": [
		"dist/",
		"assets/",
		"README.en.md",
		"byok.example.json",
		"byok.providers.example.json",
		"docs/assets/target-architecture.svg"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"type": "module",
	"bin": {
		"residualx": "dist/cli/bin.js",
		"rex": "dist/cli/bin.js"
	},
	"scripts": {
		"start": "tsx src/cli/main.ts",
		"typecheck": "tsc --noEmit",
		"build": "tsc",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"prepack": "npm run clean && npm run build",
		"test": "node scripts/run-tests.mjs",
		"test:unit": "node scripts/run-tests.mjs unit",
		"test:integration": "node scripts/run-tests.mjs integration regressions",
		"test:tui": "node scripts/run-tests.mjs tui",
		"test:e2e": "node scripts/run-tests.mjs e2e",
		"test:watch": "node scripts/run-tests.mjs --watch",
		"test:types": "tsc --project tsconfig.test.json",
		"test:coverage": "c8 node scripts/run-tests.mjs",
		"test:live": "node scripts/run-live-tests.mjs",
		"test:live:mcp": "node scripts/run-live-tests.mjs --mcp",
		"test:live:skills": "node scripts/run-live-tests.mjs --skills",
		"check": "npm run typecheck && npm run test:types && npm test && npm run build"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.4.0",
		"@modelcontextprotocol/core": "2.4.0",
		"cross-spawn": "7.0.6",
		"diff": "9.0.0",
		"highlight.js": "11.12.0",
		"ink": "6.5.1",
		"marked": "18.1.2",
		"omggif": "1.0.10",
		"react": "19.2.4",
		"react-devtools-core": "6.1.2",
		"string-width": "8.3.0",
		"typebox": "1.3.7",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/omggif": "1.0.5",
		"@types/react": "19.2.18",
		"@xterm/headless": "6.0.0",
		"c8": "12.0.0",
		"tsx": "4.21.0",
		"typescript": "5.9.3"
	}
}
